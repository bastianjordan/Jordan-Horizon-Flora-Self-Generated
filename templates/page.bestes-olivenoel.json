                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": [
            "answer"
          ]
        },
        "faq_4": {
          "type": "accordion",
          "settings": {
            "title": "Warum wird Lesbos als Referenzpunkt für Qualität genannt, obwohl es kleine Mengen produziert?",
            "open": false,
            "width": "100%",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "answer": {
              "type": "text",
              "settings": {
                "text": "<p>Lesbos sticht durch seine <strong>extrem hohe Baumdichte pro Kopf</strong> hervor, was eine tief verwurzelte Tradition und hohe Sorgfalt beim Anbau impliziert. Die spezifischen Sorten <strong>Koloví</strong> und <strong>Adramytiáni</strong> bieten ein einzigartiges, elegantes Geschmacksprofil, das von Kennern als <strong>Ausnahmeöl</strong> sehr geschätzt wird – also Qualität statt Quantität.</p>",
