          "blocks": {
            "heading": {
              "type": "text",
              "name": "Heading",
              "settings": {
                "text": "<h2>Lesbos: Das Aushängeschild für Gourmet-Qualität</h2>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h2",
                "font": "var(--font-primary--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
