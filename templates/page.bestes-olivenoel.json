                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": [
            "answer"
          ]
        },
        "faq_2": {
          "type": "accordion",
          "settings": {
            "title": "Wie erkenne ich ein echtes Olivenöl von Weltklasse?",
            "open": false,
            "width": "100%",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "answer": {
              "type": "text",
              "settings": {
                "text": "<p>Achten Sie auf folgende drei Merkmale beim Verkosten:</p><ol><li><strong>Scharf (Pungent):</strong> Ein Kratzen im Hals, das auf hohe Polyphenole hinweist.</li><li><strong>Süß/Mild (Sweet/Smooth):</strong> Eine Balance in der Textur und im ersten Geschmackseindruck.</li><li><strong>Fruchtig (Fruity):</strong> Noten von frisch geschnittenem Gras, Artischocke, Tomatenblättern oder Mandeln.</li></ol><p><strong>Zusätzlich:</strong> Prüfen Sie die <strong>Erntezeit (aktuelles Jahr)</strong> und ob es sich um eine <strong>geschützte Herkunftsbezeichnung (DOP/g.U.)</strong> handelt.</p>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
