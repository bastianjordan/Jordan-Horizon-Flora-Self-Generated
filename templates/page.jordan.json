            "heading": { "type": "text", "settings": { "text": "<h1>Jordan</h1>", "width": "fit-content", "max_width": "normal", "alignment": "left", "type_preset": "h1", "font": "var(--font-primary--family)", "font_size": "", "line_height": "normal", "letter_spacing": "normal", "case": "none", "wrap": "pretty", "color": "", "background": false, "background_color": "#00000026", "corner_radius": 0, "padding-block-start": 0, "padding-block-end": 0, "padding-inline-start": 0, "padding-inline-end": 0 }, "blocks": {} },
