        "text": {
          "type": "text",
          "settings": { "text": "<p>HIER FINDEST DU ALLE WISSENSWERTEN INFORMATIONEN ÜBER UNS UND UNSER GELIEBTES OLIVENÖL, EIN WENIG GESCHICHTE ODER ABER AUCH ALLE INFOS ZU ANSTEHENDEN EVENTS & VERKOSTUNGEN.</p>", "width": "100%", "max_width": "narrow", "alignment": "center", "type_preset": "paragraph", "font": "var(--font-body--family)", "font_size": "1rem", "line_height": "normal", "letter_spacing": "normal", "case": "none", "wrap": "pretty", "color": "", "background": false, "background_color": "#00000026", "corner_radius": 0, "padding-block-start": 0, "padding-block-end": 0, "padding-inline-start": 0, "padding-inline-end": 0 },
