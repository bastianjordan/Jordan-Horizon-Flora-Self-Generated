          "blocks": {
            "kicker": {
              "type": "text",
              "name": "Kicker",
              "settings": {
                "text": "<p>Hilfsorganisationen für ein menschenwürdeiges Leben in überfüllten Flüchtlingscamps:</p>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "overline",
                "font": "var(--font-body--family)",
                "font_size": "0.875rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
