    "hero_blumenwiese": {
      "type": "hero",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Gemeinsam mit Freunden & Partnern</strong></p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h2",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
